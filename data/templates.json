        "context_assembly": { "max_tokens": 5000, "include_metadata": true },
        "prompt": {
          "system": "You are a paralegal assistant. Quote contract clauses verbatim and cite the document and clause id.",
          "user_template": "{question}\n\nRetrieved clauses:\n{context}"
        },
        "generator": { "provider": "anthropic", "model": "claude-3-5-sonnet-latest", "temperature": 0.0 },
        "guardrails": { "input": ["pii"], "output": ["hallucination", "bias"] },
        "human_in_the_loop": { "enabled": true, "trigger": "always" },
        "evaluation": { "framework": "ragas", "metrics": ["faithfulness", "answer_relevancy", "context_precision", "context_recall"] },
        "observability": { "tracing": true, "metrics": true, "log_level": "INFO" },
        "deployment": { "target": "kubernetes" },
        "review": { "exports": ["python", "yaml", "kubernetes", "terraform"] }
      }
    },
    {
