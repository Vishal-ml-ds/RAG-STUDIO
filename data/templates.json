{
  "version": 1,
  "templates": [
    {
      "id": "pdf-chatbot",
      "name": "PDF Chatbot",
      "description": "Conversational Q&A over a folder of PDF documents using dense retrieval.",
      "category": "document-qa",
      "tags": ["pdf", "qa", "chatbot", "starter"],
      "recommended_use_cases": [
        "Internal knowledge base over user manuals",
        "Legal contract Q&A",
        "Research paper assistant"
      ],
      "stages": {
        "cloud_provider": { "provider": "aws", "region": "us-east-1" },
        "data_source": { "type": "files", "paths": ["./docs"] },
        "document_loader": { "loaders": ["pdf"] },
        "chunking": { "strategy": "recursive", "chunk_size": 1000, "chunk_overlap": 200 },
        "embedding": { "provider": "openai", "model": "text-embedding-3-small" },
        "vector_store": { "provider": "qdrant", "collection": "pdf_chatbot" },
        "retrieval": { "strategy": "dense", "top_k": 4 },
        "reranker": { "enabled": false, "provider": "cohere", "model": "rerank-english-v3.0" },
        "context_assembly": { "max_tokens": 3000, "include_metadata": true },
        "prompt": {
          "system": "You are a precise assistant answering questions from PDF documents. Always cite the source.",
          "user_template": "{question}\n\nContext:\n{context}"
        },
        "generator": { "provider": "openai", "model": "gpt-4o-mini", "temperature": 0.1 },
        "guardrails": { "input": ["pii"], "output": ["toxicity", "hallucination"] },
        "human_in_the_loop": { "enabled": false, "trigger": "low_confidence" },
        "evaluation": { "framework": "ragas", "metrics": ["faithfulness", "answer_relevancy", "context_precision"] },
        "observability": { "tracing": true, "metrics": true, "log_level": "INFO" },
        "deployment": { "target": "docker-compose" },
        "review": { "exports": ["python", "yaml"] }
      }
    },
    {
      "id": "wikipedia-qa",
      "name": "Wikipedia QA",
      "description": "Open-domain question answering over Wikipedia dumps with hybrid retrieval.",
      "category": "open-domain-qa",
      "tags": ["wikipedia", "qa", "hybrid", "open-domain"],
      "recommended_use_cases": [
        "Fact-check assistant",
        "Trivia and quiz applications",
        "General-knowledge agents"
      ],
      "stages": {
        "cloud_provider": { "provider": "aws", "region": "us-east-1" },
        "data_source": { "type": "urls", "paths": ["https://dumps.wikimedia.org/enwiki/latest/"] },
        "document_loader": { "loaders": ["html"] },
        "chunking": { "strategy": "recursive", "chunk_size": 800, "chunk_overlap": 150 },
        "embedding": { "provider": "openai", "model": "text-embedding-3-small" },
        "vector_store": { "provider": "qdrant", "collection": "wikipedia" },
        "retrieval": { "strategy": "hybrid", "top_k": 8 },
        "reranker": { "enabled": true, "provider": "cohere", "model": "rerank-english-v3.0" },
        "context_assembly": { "max_tokens": 4000, "include_metadata": true },
        "prompt": {
          "system": "You are an encyclopedic assistant. Answer factually and concisely, citing article titles.",
          "user_template": "Question: {question}\n\nRelevant Wikipedia excerpts:\n{context}"
        },
        "generator": { "provider": "openai", "model": "gpt-4o-mini", "temperature": 0.0 },
        "guardrails": { "input": ["pii"], "output": ["toxicity", "bias", "hallucination"] },
        "human_in_the_loop": { "enabled": false, "trigger": "low_confidence" },
        "evaluation": { "framework": "ragas", "metrics": ["faithfulness", "answer_relevancy", "context_precision", "context_recall"] },
        "observability": { "tracing": true, "metrics": true, "log_level": "INFO" },
        "deployment": { "target": "kubernetes" },
        "review": { "exports": ["python", "yaml", "kubernetes"] }
      }
    },
    {
      "id": "code-search",
      "name": "Code Search Assistant",
      "description": "Semantic code search and explanation over a repository or monorepo.",
      "category": "code-intelligence",
      "tags": ["code", "search", "developer-tools", "embeddings"],
      "recommended_use_cases": [
        "Internal codebase navigation",
        "Onboarding new engineers",
        "Cross-repo function lookup"
      ],
      "stages": {
        "cloud_provider": { "provider": "aws", "region": "us-east-1" },
        "data_source": { "type": "files", "paths": ["./src", "./apps"] },
        "document_loader": { "loaders": ["code", "markdown"] },
        "chunking": { "strategy": "ast", "chunk_size": 1500, "chunk_overlap": 100 },
        "embedding": { "provider": "openai", "model": "text-embedding-3-large" },
        "vector_store": { "provider": "qdrant", "collection": "code_search" },
        "retrieval": { "strategy": "dense", "top_k": 6 },
        "reranker": { "enabled": false, "provider": "cohere", "model": "rerank-english-v3.0" },
        "context_assembly": { "max_tokens": 6000, "include_metadata": true },
        "prompt": {
          "system": "You are a senior software engineer. Explain code clearly, reference file paths and line numbers.",
          "user_template": "{question}\n\nRelevant code:\n{context}"
        },
        "generator": { "provider": "anthropic", "model": "claude-3-5-sonnet-latest", "temperature": 0.0 },
        "guardrails": { "input": [], "output": ["toxicity"] },
        "human_in_the_loop": { "enabled": false, "trigger": "low_confidence" },
        "evaluation": { "framework": "ragas", "metrics": ["faithfulness", "answer_relevancy"] },
        "observability": { "tracing": true, "metrics": true, "log_level": "INFO" },
        "deployment": { "target": "docker-compose" },
        "review": { "exports": ["python", "docker-compose"] }
      }
    },
    {
      "id": "support-knowledge-base",
