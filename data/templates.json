    },
    {
      "id": "legal-contracts",
      "name": "Legal Contract Analyzer",
      "description": "High-fidelity retrieval over contracts with clause-aware chunking and strict citation.",
      "category": "legal",
      "tags": ["legal", "contracts", "compliance", "citation"],
      "recommended_use_cases": [
        "Clause extraction and comparison",
        "Vendor-contract review",
        "Compliance audits"
      ],
      "stages": {
        "cloud_provider": { "provider": "aws", "region": "us-east-1" },
        "data_source": { "type": "files", "paths": ["./contracts"] },
        "document_loader": { "loaders": ["pdf", "docx"] },
        "chunking": { "strategy": "clause", "chunk_size": 1200, "chunk_overlap": 250 },
        "embedding": { "provider": "openai", "model": "text-embedding-3-large" },
        "vector_store": { "provider": "qdrant", "collection": "legal_contracts" },
        "retrieval": { "strategy": "hybrid", "top_k": 10 },
